# backtest-overfitting-lab: copy to .env (git-ignored) and fill in. Nothing here is required for the core library.
# Optional (the owner will set it). Sharadar API key for the owner's Full History Bundle: default source of U.S. ETF daily prices
# (Sharadar SFP, included in the bundle, P-17). If empty, U.S. ETF prices fall back to the local Stooq snapshot.
SHARADAR_API_KEY=
# Optional, normally unneeded. Tiingo API token, used only by `olab-study data tiingo` as an extra cross-check (free tier only).
TIINGO_API_KEY=
# Owner-supplied Stooq bulk daily snapshot (d_us_txt, d_world_txt; through 2026-10-30, P-06). Read once and converted to Parquet under data/.
# Native Windows: E:\trading-strategy-brainstorm\data\stooq
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq
# Data root under WSL: inside the WSL ext4 filesystem, never /mnt/* (~ is expanded by the settings loader).
# Native Windows: leave empty so data goes to the repo's ./data on D: (~ would point at C:).
DATA_ROOT=~/data/backtest-overfitting-lab
# Optional. Root folder for raw/interim/processed data; empty = DATA_ROOT, or ./data (git-ignored) when DATA_ROOT is empty.
OLAB_DATA_DIR=
# Optional. Folder for experiment_log.csv, trial_log.csv and run logs (default ./results).
OLAB_RESULTS_DIR=./results
# Optional. Folder for figures and tables used by the memo (default ./reports).
OLAB_REPORTS_DIR=./reports
# Optional. Master seed for every study command (default 20261030).
OLAB_SEED=20261030
# Optional. Local clones of sibling repos whose trial logs feed the own-projects table.
OLAB_EQUITY_FACTOR_PIPELINE_DIR=../equity-factor-pipeline
OLAB_LLM_TEXT_ALPHA_DIR=../llm-text-alpha
OLAB_STAT_ARB_PAIRS_DIR=../stat-arb-pairs
OLAB_REGIME_PORTFOLIO_CONSTRUCTION_DIR=../regime-portfolio-construction
OLAB_CRYPTO_LOB_ALPHA_DIR=../crypto-lob-alpha
OLAB_MARKET_MAKING_SIM_DIR=../market-making-sim
# Optional. Numba on-disk cache location (default: next to the sources).
NUMBA_CACHE_DIR=
# Note: no PyPI token. Releases use PyPI Trusted Publishing (OIDC) from GitHub Actions.
